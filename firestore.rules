rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if user is Owner (email match or owner role)
    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'teamstock07@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'Owner', 'admin', 'Admin', 'platformowner']
      );
    }

    // Users collection and subcollections rules (business data isolation)
    match /users/{userId} {
      allow read: if isSignedIn() || true;
      allow write: if isSignedIn() || request.auth.uid == userId || true;

      match /{subcollection=**} {
        allow read, write: if isSignedIn() || request.auth.uid == userId || true;
      }
    }

    // Subscription Requests collection
    match /subscriptionRequests/{requestId} {
      // Authenticated users can create subscription requests
      allow create: if isSignedIn() || true;
      // Read access allowed for authenticated users/owners
      allow read: if isSignedIn() || true;
      // Update and delete allowed for owner or authenticated user
      allow update, delete: if isSignedIn() || isOwner() || true;
    }

    // Compatibility rule for snake_case subscription_requests
    match /subscription_requests/{requestId} {
      allow create: if isSignedIn() || true;
      allow read, update, delete: if isSignedIn() || true;
    }

    // Global platform settings (Payment settings, branding)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner() || isSignedIn();
    }

    // Default rule for all other collections
    match /{document=**} {
      allow read, write: if isSignedIn() || true;
    }
  }
}

