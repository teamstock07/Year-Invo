{
  "entities": {
    "users": {
      "title": "users",
      "description": "Registered user accounts and stores in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "storeName": { "type": "string" },
        "storeType": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "affiliateCode": { "type": "string" },
        "role": { "type": "string" },
        "subscription": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "ownerName": { "type": "string" },
        "brandName": { "type": "string" },
        "businessType": { "type": "string" },
        "mobile": { "type": "string" },
        "storeAddress": { "type": "string" },
        "subscriptionPlan": { "type": "string" }
      },
      "required": ["uid", "fullName", "email", "storeName", "role"]
    },
    "subscription_requests": {
      "title": "subscription_requests",
      "description": "Plan upgrade requests submitted by users for owner approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "brandName": { "type": "string" },
        "currentPlan": { "type": "string" },
        "requestedPlan": { "type": "string" },
        "billingCycle": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "requestDate": { "type": "string" }
      },
      "required": ["id", "userId", "requestedPlan", "status"]
    },
    "email_verifications": {
      "title": "email_verifications",
      "description": "Hashed 6-digit OTP verification records for user email confirmation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "codeHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "attempts": { "type": "number" },
        "maxAttempts": { "type": "number" },
        "verified": { "type": "boolean" },
        "lastSentAt": { "type": "string" }
      },
      "required": ["id", "email", "codeHash", "expiresAt", "verified"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "users",
      "description": "User profiles indexed by Firebase Auth UID"
    },
    "/subscriptionRequests/{requestId}": {
      "schema": "subscription_requests",
      "description": "User plan subscription requests"
    },
    "/subscription_requests/{requestId}": {
      "schema": "subscription_requests",
      "description": "User plan subscription requests"
    },
    "/emailVerifications/{docId}": {
      "schema": "email_verifications",
      "description": "Server-managed email verification OTP records"
    }
  }
}
